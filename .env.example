# Copy to .env and fill in; .env is gitignored, this file is the committed template.

# Training only: OpenWeather API key read by every live training/*.py script for race-day forecasts.
# Never commit a real value; keep it only in your local .env.
openweatherapi=""

# API only, optional: port the FastAPI server listens on.
PORT=8000

# API only, optional: folder holding the *.joblib models; config.py defaults to <repo>/models when unset.
MODELS_DIR=
